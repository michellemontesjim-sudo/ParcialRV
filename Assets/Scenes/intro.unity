--- !u!114 &797805059
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 797805058}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d6c3f1fc585a2d43b51912e50afa37c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MesaQuimica
  panelCinematica: {fileID: 1389356430}
  panelReceta: {fileID: 0}
  textoDialogoCinematica: {fileID: 1583094998}
  textoInstruccionesReceta: {fileID: 0}
  textoPuntaje: {fileID: 0}
  textoTemporizador: {fileID: 0}
  velocidadEscritura: 0.05
  animMascota: {fileID: 0}
  audioSourceMascota: {fileID: 797805063}
  niveles:
  - dialogosCinematica:
    - texto: "\xA1Bienvenido al laboratorio de qu\xEDmica!"
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    - texto: "Hoy aprender\xE1s a hacer diferentes mezclas con diferentes elementos"
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    - texto: "Empecemos con una peque\xF1a gu\xEDa para hacer qu\xEDmicos/mezclas"
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    - texto: "Comencemos haciendo algo sencillo, \xA1Agua!"
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    - texto: "El agua es b\xE1sicamente H2O"
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    - texto: "Por lo que necesitar\xE1s hidr\xF3geno y ox\xEDgeno"
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    - texto: Busca los ingredientes en los estantes o cajas
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    - texto: "Y traelos a esta mesa de qu\xEDmica"
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    - texto: "Su\xE9ltalos y se prepar\xE1 la receta si los ingredientes son correctos"
      audioVoz: {fileID: 8300000, guid: 3a8fa145447b3ca41b963dd46bac1b6f, type: 3}
    tieneTiempoLimite: 0
    tiempoEnSegundos: 0
    requiereIngredientesCalientes: 0
    recetasDelNivel:
    - nombreReceta: H2O
      ingredientes:
      - "Hidr\xF3geno"
      - "Hidr\xF3geno"
      - "Ox\xEDgeno"
  - dialogosCinematica:
    - texto: "\xA1Perfecto! Ahora sigamos con otra receta simple"
      audioVoz: {fileID: 0}
    - texto: Esta vez es cloruro de sodio, osea NaCl
      audioVoz: {fileID: 0}
    - texto: "\xA1Busca los ingredientes correctos!"
      audioVoz: {fileID: 0}
    tieneTiempoLimite: 0
    tiempoEnSegundos: 60
    requiereIngredientesCalientes: 0
    recetasDelNivel:
    - nombreReceta: NaCl
      ingredientes:
      - Sodio
      - Cloro
  - dialogosCinematica:
    - texto: "\xA1Muy bien! Ahora seguir\xE1s haciendo las recetas t\xFA"
      audioVoz: {fileID: 0}
    - texto: "Se te mostrar\xE1 un qu\xEDmico y tu tendr\xE1s que hacerlo"
      audioVoz: {fileID: 0}
    - texto: "\xA1Suerte!"
      audioVoz: {fileID: 0}
    tieneTiempoLimite: 0
    tiempoEnSegundos: 0
    requiereIngredientesCalientes: 0
    recetasDelNivel:
    - nombreReceta: "Alcohol et\xEDlico"
      ingredientes:
      - Carbono
      - Carbono
      - "Hidr\xF3geno"
      - "Hidr\xF3geno"
      - "Hidr\xF3geno"
      - "Hidr\xF3geno"
      - "Hidr\xF3geno"
      - "Hidr\xF3geno"
      - "Ox\xEDgeno"
    - nombreReceta: Dicromato
      ingredientes:
      - Cromo
      - Cromo
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
  - dialogosCinematica:
    - texto: "\xA1Sigue con la creaci\xF3n de los qu\xEDmicos!"
      audioVoz: {fileID: 0}
    - texto: "\xA1Ya casi lo logras!"
      audioVoz: {fileID: 0}
    tieneTiempoLimite: 0
    tiempoEnSegundos: 0
    requiereIngredientesCalientes: 0
    recetasDelNivel:
    - nombreReceta: Dicromato de potasio
      ingredientes:
      - Potasio
      - Potasio
      - Cromo
      - Cromo
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
    - nombreReceta: "\xC1cido Sulf\xFArico"
      ingredientes:
      - "Hidr\xF3geno"
      - "Hidr\xF3geno"
      - Azufre
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
      - "Ox\xEDgeno"
  puntajeJugador: 0
  sonidoExito: {fileID: 0}
  humoQuimico: {fileID: 0}
  puntosPorError: 5
